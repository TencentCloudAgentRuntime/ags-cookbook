+++ b/examples/session-cookbook/deepseek-harness/dsh-0.2.1-rc.2/plugin/dsh-handoff-plugin.js
@@ -0,0 +1,48 @@
+/**
+ * Cordis runtime plugin for stateless session handoff.
+ *
+ * This is the piece that actually calls `attachDshHandoff` at runtime. The
+ * persistence plugin (`index.js`) only owns storage; it never sees the Agent or
+ * the turn boundary, so it cannot rebuild a live generation by itself.
+ *
+ * Load it after `session-persistence-agent-runtime`:
+ *
+ *   - id: dsh-stateless-handoff
+ *     name: '@tencentcloud/ags-dsh-session-persistence/handoff'
+ *
+ * The DSH source patch (`dockerfiles/0001-stateless-handoff.patch`) calls the
+ * `sessionHandoff` service this plugin registers, after resolving the Agent and
+ * before admitting a non-steer prompt.
+ */
+
+import { attachDshHandoff } from './dsh-handoff.js'
+import { openTurnTimeoutFromEnv } from './constants.js'
+
+export const name = 'dsh-stateless-handoff'
+
+// `sessionController` supplies invalidateGeneration()/resumeGeneration(); the
+// other two are the public liveness signals read by attachDshHandoff().
+export const inject = ['agents', 'sessionController', 'sessionPersistence', 'sessionProjections']
+
+export function apply(ctx, config = {}) {
+  // stderr, so the handoff state transitions are visible in the DSH process log
+  // even when the host logger has no info exporter configured.
+  const logger = typeof config.logger === 'function'
+    ? config.logger
+    : (message, fields) => console.error(`[dsh-stateless-handoff] ${message} ${JSON.stringify(fields)}`)
+
+  // An unfinished turn is taken over once it has shown no activity for this long.
+  const openTurnTimeoutMs = openTurnTimeoutFromEnv()
+  logger('open-turn timeout', { openTurnTimeoutMs })
+
+  const { dispose } = attachDshHandoff(ctx, {
+    generation: {
+      invalidate: sessionId => ctx.sessionController.invalidateGeneration(sessionId),
+      resume: sessionId => ctx.sessionController.resumeGeneration(sessionId),
+    },
+    logger,
+    openTurnTimeoutMs,
+  })
+
+  ctx.effect(() => dispose, 'dsh-stateless-handoff: conflict listener')
+}
diff --git a/examples/session-cookbook/deepseek-harness/dsh-0.2.1-rc.2/plugin/dsh-handoff.js b/examples/session-cookbook/deepseek-harness/dsh-0.2.1-rc.2/plugin/dsh-handoff.js
new file mode 100644
--- /dev/null
+++ b/examples/session-cookbook/deepseek-harness/dsh-0.2.1-rc.2/plugin/dsh-handoff.js
@@ -0,0 +1,113 @@
+/**
+ * Minimal DSH wiring for the handoff controller.
+ *
+ * The persistence plugin and the controller are version-independent. The only
+ * version-specific operations are the `generation` port and the liveness ports,
+ * implemented with the DSH 0.2.1-rc.2 agent/session-controller APIs:
+ *
+ *   generation.invalidate(sessionId)  stop input, cancel/await the turn, dispose
+ *                                     the agent, and finish teardown
+ *   generation.resume(sessionId)      reopen through ctx.agents.resume()
+ *   generation.flush(sessionId)?      optional; flush before a local-ahead check
+ *
+ * `attachDshHandoff` additionally reads two public DSH signals:
+ *
+ *   ctx.agents.get(id)?.status                       'idle' | 'running'
+ *   ctx.sessionProjections.stateOf(session,'turnBoundary')
+ *
+ * They are the only way to distinguish a turn this replica is still driving
+ * from an open turn left by a crash or another replica. Without them the
+ * controller stays conservative and refuses an open turn.
+ */
+
+import { attachConflictRecovery, createHandoffController, HandoffBusyError } from './handoff-controller.js'
+import { DEFAULT_OPEN_TURN_TIMEOUT_MS } from './constants.js'
+
+export function createDshHandoff({ persistence, generation, liveAgentStatus, liveTurnState, logger, openTurnTimeoutMs }) {
+  if (!generation || typeof generation.invalidate !== 'function' || typeof generation.resume !== 'function') {
+    throw new TypeError('generation must provide invalidate() and resume()')
+  }
+
+  const host = {
+    localEventCount: async sessionId => {
+      await persistence.flushWriter?.(sessionId)
+      return persistence.writerCursor(sessionId)
+    },
+    invalidate: sessionId => generation.invalidate(sessionId),
+    resume: sessionId => generation.resume(sessionId),
+  }
+  if (typeof generation.flush === 'function') {
+    host.flush = sessionId => generation.flush(sessionId)
+  }
+  if (typeof liveAgentStatus === 'function') host.liveAgentStatus = liveAgentStatus
+  if (typeof liveTurnState === 'function') host.liveTurnState = liveTurnState
+  return createHandoffController({ persistence, host, logger, openTurnTimeoutMs })
+}
+
+/**
+ * Cordis helper: create the controller from `ctx.sessionPersistence`, derive
+ * the liveness ports from `ctx.agents` / `ctx.sessionProjections`, and route
+ * `session-persistence/conflict` into recover(). The caller still has to call
+ * `controller.preflight(sessionId)` before each turn; the plugin cannot see the
+ * turn boundary — the DSH source patch calls it after the Agent is resolved.
+ *
+ * @returns {{ controller: ReturnType<typeof createHandoffController>, dispose: () => void }}
+ */
+export function attachDshHandoff(ctx, { generation, logger = () => {}, openTurnTimeoutMs = DEFAULT_OPEN_TURN_TIMEOUT_MS } = {}) {
+  if (!ctx || typeof ctx.on !== 'function') throw new TypeError('ctx.on is required')
+  const persistence = ctx.sessionPersistence
+  if (!persistence) throw new TypeError('ctx.sessionPersistence is required')
+  // The persistence layer applies the same timeout when a Session is opened for
+  // writing, before DSH's own crash repair can run. The previous value is
+  // restored when this plugin unloads.
+  const previousTimeout = persistence.openTurnTimeoutMs
+  persistence.openTurnTimeoutMs = openTurnTimeoutMs
+
+  const liveAgentStatus = sessionId => ctx.get?.('agents')?.get?.(sessionId)?.status
+  const liveTurnState = sessionId => {
+    const agent = ctx.get?.('agents')?.get?.(sessionId)
+    if (agent === undefined) return undefined
+    const boundary = ctx.get?.('sessionProjections')?.stateOf?.(agent.session, 'turnBoundary')
+    if (boundary === undefined) return undefined
+    if (boundary.openTurnStartSeq !== null) return 'open'
+    return boundary.lastTurn === 0 ? 'none' : 'closed'
+  }
+
+  const controller = createDshHandoff({ persistence, generation, liveAgentStatus, liveTurnState, logger, openTurnTimeoutMs })
+  // The DSH source patch calls this before admitting a non-steer prompt, after
+  // resolving the Agent. `rebuilt` tells the caller to resolve again because
+  // the Agent it held was disposed.
+  //
+  // Cordis requires `ctx.provide()` for a new service: `ctx.set()` throws when
+  // the name was never provided by this fiber. The returned disposer is owned
+  // by the plugin fiber, so unloading the integration plugin removes it.
+  const handoff = {
+    beforePrompt: async sessionId => {
+      const decision = await controller.preflight(sessionId)
+      // The common case (`run`) is not worth a log line per prompt.
+      if (decision.action !== 'run') {
+        logger('handoff preflight', {
+          sessionId,
+          action: decision.action,
+          state: decision.check?.state,
+          turnState: decision.check?.turnState,
+        })
+      }
+      if (decision.action === 'blocked') throw new HandoffBusyError(sessionId, decision.check, 'local-ahead')
+      return decision
+    },
+  }
+  if (typeof ctx.provide === 'function') {
+    ctx.provide('sessionHandoff', handoff)
+  } else if (typeof ctx.set === 'function') {
+    // Minimal hosts and unit tests that do not implement Cordis provide().
+    ctx.set('sessionHandoff', handoff)
+  }
+  logger('handoff service registered', {})
+  const stopRecovery = attachConflictRecovery(ctx, controller, { logger })
+  const dispose = () => {
+    stopRecovery()
+    persistence.openTurnTimeoutMs = previousTimeout
+  }
+  return { controller, dispose }
+}
diff --git a/examples/session-cookbook/deepseek-harness/dsh-0.2.1-rc.2/plugin/dsh-handoff.test.js b/examples/session-cookbook/deepseek-harness/dsh-0.2.1-rc.2/plugin/dsh-handoff.test.js
new file mode 100644
--- /dev/null
+++ b/examples/session-cookbook/deepseek-harness/dsh-0.2.1-rc.2/plugin/dsh-handoff.test.js
@@ -0,0 +1,290 @@
+import assert from 'node:assert/strict'
+import test from 'node:test'
+import { attachDshHandoff, createDshHandoff } from './dsh-handoff.js'
+import { HandoffBusyError } from './handoff-controller.js'
+import { apply as applyIntegration } from './dsh-handoff-plugin.js'
+
+function check(state, turnState = 'closed') {
+  return {
+    state,
+    cloudEventCount: 2,
+    localEventCount: 2,
+    turnState,
+    turnClosed: turnState === 'closed',
+  }
+}
+
+function fakePersistence(checks) {
+  const calls = []
+  let index = 0
+  return {
+    calls,
+    writerCursor(sessionId) {
+      calls.push(['writerCursor', sessionId])
+      return 2
+    },
+    async handoffCheck(sessionId, localEventCount) {
+      calls.push(['handoffCheck', sessionId, localEventCount])
+      return Array.isArray(checks) ? checks[Math.min(index++, checks.length - 1)] : checks
+    },
+    async releaseWriter(sessionId) {
+      calls.push(['releaseWriter', sessionId])
+    },
+  }
+}
+
+function fakeGeneration({ flush } = {}) {
+  const calls = []
+  const generation = {
+    calls,
+    async invalidate(sessionId) {
+      calls.push(['invalidate', sessionId])
+    },
+    async resume(sessionId) {
+      calls.push(['resume', sessionId])
+      return { sessionId }
+    },
+  }
+  if (flush !== undefined) {
+    generation.flush = async sessionId => {
+      calls.push(['flush', sessionId])
+      await flush(sessionId)
+    }
+  }
+  return generation
+}
+
+function fakeCtx(persistence, { agents, sessionProjections } = {}) {
+  const services = new Map()
+  const handlers = new Map()
+  if (agents !== undefined) services.set('agents', agents)
+  if (sessionProjections !== undefined) services.set('sessionProjections', sessionProjections)
+  return {
+    handlers,
+    sessionPersistence: persistence,
+    on(name, handler) {
+      handlers.set(name, handler)
+      return () => handlers.delete(name)
+    },
+    provide(name, value) {
+      services.set(name, value)
+      return () => services.delete(name)
+    },
+    set(name, value) {
+      services.set(name, value)
+    },
+    get(name) {
+      return services.get(name)
+    },
+  }
+}
+
+function liveAgent(status) {
+  const agent = { id: 'session-live', session: { id: 'session-live' }, status }
+  return { get: sessionId => (sessionId === 'session-live' ? agent : undefined) }
+}
+
+function projection(boundary) {
+  return { stateOf: () => boundary }
+}
+
+test('createDshHandoff rebuilds a stale generation through the port', async () => {
+  const persistence = fakePersistence(check('stale'))
+  const generation = fakeGeneration()
+  const controller = createDshHandoff({ persistence, generation })
+
+  const result = await controller.preflight('session-a')
+  assert.equal(result.action, 'rebuilt')
+  assert.deepEqual(generation.calls.map(call => call[0]), ['invalidate', 'resume'])
+  assert.deepEqual(persistence.calls.map(call => call[0]), ['writerCursor', 'handoffCheck', 'releaseWriter'])
+})
+
+test('createDshHandoff forwards the optional flush operation', async () => {
+  const persistence = fakePersistence([check('local-ahead'), check('fresh')])
+  const generation = fakeGeneration({ flush: async () => {} })
+  const controller = createDshHandoff({ persistence, generation })
+
+  const result = await controller.preflight('session-b')
+  assert.equal(result.action, 'run')
+  assert.equal(generation.calls.some(call => call[0] === 'flush'), true)
+})
+
+test('createDshHandoff accepts the optional liveness ports', async () => {
+  const persistence = fakePersistence(check('fresh', 'open'))
+  const generation = fakeGeneration()
+  const controller = createDshHandoff({
+    persistence,
+    generation,
+    liveAgentStatus: () => 'running',
+    liveTurnState: () => 'open',
+  })
+
+  const result = await controller.preflight('session-live')
+  assert.equal(result.action, 'run')
+})
+
+test('attachDshHandoff derives liveness from agents and session projections', async () => {
+  const ctx = fakeCtx(fakePersistence(check('fresh', 'open')), {
+    agents: liveAgent('running'),
+    sessionProjections: projection({ openTurnStartSeq: 1, lastTurn: 1 }),
+  })
+  const generation = fakeGeneration()
+  attachDshHandoff(ctx, { generation })
+
+  const decision = await ctx.get('sessionHandoff').beforePrompt('session-live')
+  assert.equal(decision.action, 'run')
+})
+
+test('attachDshHandoff refuses a resumed open turn when the live Agent is idle', async () => {
+  const ctx = fakeCtx(fakePersistence(check('fresh', 'open')), {
+    agents: liveAgent('idle'),
+    sessionProjections: projection({ openTurnStartSeq: 1, lastTurn: 1 }),
+  })
+  const generation = fakeGeneration()
+  attachDshHandoff(ctx, { generation })
+
+  await assert.rejects(
+    ctx.get('sessionHandoff').beforePrompt('session-live'),
+    HandoffBusyError,
+  )
+})
+
+test('attachDshHandoff treats a never-started Session as none, not open', async () => {
+  const ctx = fakeCtx(fakePersistence(check('fresh', 'none')), {
+    agents: liveAgent('idle'),
+    sessionProjections: projection({ openTurnStartSeq: null, lastTurn: 0 }),
+  })
+  const generation = fakeGeneration()
+  attachDshHandoff(ctx, { generation })
+
+  const decision = await ctx.get('sessionHandoff').beforePrompt('session-live')
+  assert.equal(decision.action, 'run')
+})
+
+test('attachDshHandoff wires the conflict event to recovery', async () => {
+  const ctx = fakeCtx(fakePersistence(check('fresh')))
+  const generation = fakeGeneration()
+  const { controller, dispose } = attachDshHandoff(ctx, { generation })
+  assert.equal(typeof controller.preflight, 'function')
+
+  const listener = ctx.handlers.get('session-persistence/conflict')
+  await listener({ id: 'session-c' }, new Error('conflict'))
+  assert.deepEqual(generation.calls.map(call => call[0]), ['invalidate', 'resume'])
+
+  dispose()
+  assert.equal(ctx.handlers.has('session-persistence/conflict'), false)
+})
+
+test('attachDshHandoff installs the pre-prompt hook', async () => {
+  const ctx = fakeCtx(fakePersistence(check('stale')))
+  const generation = fakeGeneration()
+  attachDshHandoff(ctx, { generation })
+
+  const handoff = ctx.get('sessionHandoff')
+  assert.equal(typeof handoff.beforePrompt, 'function')
+  const decision = await handoff.beforePrompt('session-d')
+  assert.equal(decision.action, 'rebuilt')
+  assert.deepEqual(generation.calls.map(call => call[0]), ['invalidate', 'resume'])
+})
+
+test('the pre-prompt hook reports a blocked handoff as busy', async () => {
+  const ctx = fakeCtx(fakePersistence(check('local-ahead')))
+  const generation = fakeGeneration()
+  attachDshHandoff(ctx, { generation })
+
+  await assert.rejects(
+    ctx.get('sessionHandoff').beforePrompt('session-e'),
+    HandoffBusyError,
+  )
+  assert.equal(generation.calls.length, 0)
+})
+
+test('createDshHandoff rejects an incomplete generation port', () => {
+  assert.throws(
+    () => createDshHandoff({ persistence: fakePersistence(check('fresh')), generation: {} }),
+    /invalidate/,
+  )
+})
+
+test('attachDshHandoff requires ctx.sessionPersistence', () => {
+  assert.throws(
+    () => attachDshHandoff({ on() {} }, { generation: fakeGeneration() }),
+    /sessionPersistence/,
+  )
+})
+
+test('the integration plugin registers the handoff service and conflict recovery', async () => {
+  const persistence = fakePersistence(check('fresh'))
+  const calls = []
+  const disposers = []
+  const ctx = {
+    sessionPersistence: persistence,
+    sessionController: {
+      async invalidateGeneration(sessionId) {
+        calls.push(['invalidateGeneration', sessionId])
+      },
+      async resumeGeneration(sessionId) {
+        calls.push(['resumeGeneration', sessionId])
+        return { id: sessionId }
+      },
+    },
+    agents: { get: () => undefined },
+    sessionProjections: { stateOf: () => undefined },
+    on(name, handler) {
+      this.handlers ??= new Map()
+      this.handlers.set(name, handler)
+      return () => this.handlers.delete(name)
+    },
+    provide(name, value) {
+      this.services ??= new Map()
+      this.services.set(name, value)
+      return () => this.services.delete(name)
+    },
+    set(name, value) {
+      this.services ??= new Map()
+      this.services.set(name, value)
+    },
+    get(name) {
+      return this.services?.get(name)
+    },
+    effect(create, label) {
+      disposers.push([label, create()])
+      return () => {}
+    },
+    logger: { info() {} },
+  }
+
+  applyIntegration(ctx, {})
+  assert.equal(typeof ctx.get('sessionHandoff').beforePrompt, 'function')
+  assert.equal(ctx.handlers.has('session-persistence/conflict'), true)
+  assert.equal(disposers.length, 1)
+
+  await ctx.handlers.get('session-persistence/conflict')({ id: 'session-plugin' }, new Error('conflict'))
+  assert.deepEqual(calls, [
+    ['invalidateGeneration', 'session-plugin'],
+    ['resumeGeneration', 'session-plugin'],
+  ])
+})
+
+
+test('the open-turn timeout is applied while the plugin is attached and restored on dispose', () => {
+  const persistence = fakePersistence(check('fresh'))
+  persistence.openTurnTimeoutMs = undefined
+  const ctx = fakeCtx(persistence)
+  const { dispose } = attachDshHandoff(ctx, { generation: fakeGeneration() })
+  assert.equal(persistence.openTurnTimeoutMs, 10 * 60 * 1000)
+  dispose()
+  assert.equal(persistence.openTurnTimeoutMs, undefined)
+})
+
+test('the open-turn timeout can be configured', () => {
+  const persistence = fakePersistence(check('fresh'))
+  attachDshHandoff(fakeCtx(persistence), { generation: fakeGeneration(), openTurnTimeoutMs: 90_000 })
+  assert.equal(persistence.openTurnTimeoutMs, 90_000)
+})
+
+test('a blocked local-ahead state is reported as such, not as an open turn', async () => {
+  const ctx = fakeCtx(fakePersistence(check('local-ahead')))
+  attachDshHandoff(ctx, { generation: fakeGeneration() })
+  await assert.rejects(ctx.get('sessionHandoff').beforePrompt('s'), error => error.reason === 'local-ahead')
+})
diff --git a/examples/session-cookbook/deepseek-harness/dsh-0.2.1-rc.2/plugin/handoff-controller.js b/examples/session-cookbook/deepseek-harness/dsh-0.2.1-rc.2/plugin/handoff-controller.js
new file mode 100644
--- /dev/null
+++ b/examples/session-cookbook/deepseek-harness/dsh-0.2.1-rc.2/plugin/handoff-controller.js
@@ -0,0 +1,236 @@
+/**
+ * Turns the persistence plugin's handoff primitives into an explicit state
+ * machine for the owner of the live session.
+ *
+ * The controller is deliberately host-agnostic: it never imports DSH. The
+ * integration supplies three required operations:
+ *
+ *   host.localEventCount(sessionId)  durable events this replica has written
+ *   host.invalidate(sessionId)       stop input, cancel/await the turn, dispose
+ *                                    the agent, and finish teardown
+ *   host.resume(sessionId)           reopen through DSH's resume path
+ *
+ * `host.invalidate` MUST await teardown; `persistence.releaseWriter` is called
+ * after it to make sure the in-process write claim is gone before `resume`.
+ *
+ * Two optional operations let the caller distinguish a turn this replica is
+ * actually driving from one that only exists as an open log:
+ *
+ *   host.liveAgentStatus(sessionId)  'idle' | 'running' | undefined
+ *   host.liveTurnState(sessionId)    'none' | 'open' | 'closed' | undefined
+ *
+ * The log alone is not a liveness signal: a crashed turn and a running turn on
+ * another replica look identical. A live Agent's `status` is the liveness
+ * signal, and its Session projection is the authoritative turn boundary for
+ * the fresh case.
+ *
+ * When this replica's own Agent is running a turn, preflight returns `run`
+ * without reading the cloud. The turn already holds its claim (turn/start is
+ * persisted before any work), so another writer cannot be running one, and a
+ * read would only race this replica's own in-flight appends.
+ */
+
+import { SESSION_PERSISTENCE_CONFLICT, idleMs } from './constants.js'
+
+/**
+ * A new turn was refused because the stored log or the live generation is in
+ * a state this replica must not act on automatically.
+ */
+export class HandoffBusyError extends Error {
+  /**
+   * @param sessionId - Session that refused the turn.
+   * @param check - the handoffCheck() value the decision was made from.
+   * @param reason - why the turn was refused.
+   */
+  constructor(sessionId, check, reason = 'open-turn', retryAfterMs = undefined) {
+    super(`session "${sessionId}" cannot start a new turn: ${describe(check, reason)}`)
+    this.name = 'HandoffBusyError'
+    this.code = 'session/handoff-busy'
+    this.sessionId = sessionId
+    this.check = check
+    this.reason = reason
+    /** When set, a retry after this many milliseconds is expected to succeed if the turn really crashed. */
+    this.retryAfterMs = retryAfterMs
+  }
+}
+
+function turnStateOf(check) {
+  if (check?.turnState !== undefined) return check.turnState
+  // Backward compatibility for hosts that only report the two-state view.
+  return check?.turnClosed ? 'closed' : 'open'
+}
+
+function describe(check, reason) {
+  if (reason === 'local-ahead') return 'this replica holds events that are not stored yet'
+  const turnState = turnStateOf(check)
+  if (turnState === 'open') {
+    return check.state === 'stale'
+      ? 'the stored log is ahead and the last turn is still open'
+      : 'an open turn has no driver in this replica'
+  }
+  return check.state
+}
+
+export function createHandoffController({ persistence, host, logger = () => {}, openTurnTimeoutMs, now = Date.now }) {
+  if (!persistence || typeof persistence.handoffCheck !== 'function' || typeof persistence.releaseWriter !== 'function') {
+    throw new TypeError('persistence must provide handoffCheck() and releaseWriter()')
+  }
+  if (!host || typeof host.localEventCount !== 'function' || typeof host.invalidate !== 'function' || typeof host.resume !== 'function') {
+    throw new TypeError('host must provide localEventCount(), invalidate(), and resume()')
+  }
+  for (const name of ['liveAgentStatus', 'liveTurnState']) {
+    if (host[name] !== undefined && typeof host[name] !== 'function') {
+      throw new TypeError(`host.${name} must be a function when provided`)
+    }
+  }
+
+  // Coalesce concurrent rebuilds so two conflicts cannot tear down twice.
+  const rebuilding = new Map()
+
+  async function check(sessionId) {
+    // A rebuild disposes and reopens the writer. Reading the cursor while it is
+    // in flight could observe a half-torn-down generation, so serialize behind
+    // the in-flight rebuild first.
+    const running = rebuilding.get(sessionId)
+    if (running !== undefined) await running.catch(() => undefined)
+    const localEventCount = await host.localEventCount(sessionId)
+    return persistence.handoffCheck(sessionId, localEventCount)
+  }
+
+  async function rebuild(sessionId, reason, allowOpenTurn = true) {
+    const running = rebuilding.get(sessionId)
+    if (running !== undefined) return running
+
+    const task = (async () => {
+      logger('handoff rebuild started', { sessionId, reason })
+      // Stop the old generation first; resuming before teardown would race the
+      // in-process write claim and the live Session object.
+      await host.invalidate(sessionId)
+      await persistence.releaseWriter(sessionId)
+      if (!allowOpenTurn) {
+        // A losing executor may discard its generation, but conflict recovery
+        // must not take the winner's turn back, even after its quiet timeout.
+        // Only an explicit new prompt is allowed to initiate timeout takeover.
+        const current = await persistence.handoffCheck(sessionId, 0)
+        if (turnStateOf(current) === 'open') throw new HandoffBusyError(sessionId, current)
+      }
+      const generation = await host.resume(sessionId)
+      logger('handoff rebuild finished', { sessionId, reason })
+      return generation
+    })()
+    rebuilding.set(sessionId, task)
+    try {
+      return await task
+    } finally {
+      rebuilding.delete(sessionId)
+    }
+  }
+
+  // A stale local view cannot see the remote tail, so the cloud-derived state
+  // from handoffCheck() is authoritative. When the log matches, prefer the live
+  // Agent's own projection: it is O(1) and distinguishes an empty log from an
+  // open turn.
+  async function resolveTurnState(sessionId, current) {
+    if (current.state !== 'stale' && typeof host.liveTurnState === 'function') {
+      const live = await host.liveTurnState(sessionId)
+      if (live !== undefined) return live
+    }
+    return turnStateOf(current)
+  }
+
+  async function resolveAgentStatus(sessionId) {
+    if (typeof host.liveAgentStatus !== 'function') return undefined
+    return host.liveAgentStatus(sessionId)
+  }
+
+  /**
+   * Decide what to do before a new turn.
+   *
+   * - `run`      this replica may admit the turn
+   * - `rebuilt`  a stale generation was invalidated and resumed
+   * - `create`   the Session does not exist yet
+   * - `blocked`  local is ahead (flush failed or was unavailable)
+   *
+   * Throws HandoffBusyError when the stored log is ahead and its turn is open,
+   * or when an open turn has no driver here and has not reached the configured
+   * quiet timeout. Older open turns are rebuilt through native crash repair.
+   */
+  async function preflight(sessionId) {
+    // Our own turn is running: queueing more input is normal and needs no cloud read.
+    if (await resolveAgentStatus(sessionId) === 'running') return { action: 'run' }
+
+    let current = await check(sessionId)
+
+    if (current.state === 'local-ahead' && typeof host.flush === 'function') {
+      await host.flush(sessionId)
+      current = await check(sessionId)
+    }
+
+    if (current.state === 'not-found') return { action: 'create', check: current }
+    if (current.state === 'local-ahead') return { action: 'blocked', check: current }
+
+    const turnState = await resolveTurnState(sessionId, current)
+    // Here this replica's Agent is idle, so an open turn has no driver in this
+    // process. Either another replica is running it or it was left by a crash,
+    // and the log cannot tell which. Activity tells: a turn that recently wrote an
+    // event may be alive and is refused; one quiet for the whole timeout is
+    // treated as a crash and closed by rebuilding, which makes DSH's own crash
+    // repair run when the Session is reopened for writing. Without a configured
+    // timeout nothing is ever taken over.
+    if (turnState === 'open') {
+      const idle = idleMs(current.lastEvent, now())
+      if (openTurnTimeoutMs === undefined || idle === undefined || idle < openTurnTimeoutMs) {
+        const retryAfterMs = openTurnTimeoutMs === undefined ? undefined : Math.ceil(openTurnTimeoutMs - (idle ?? 0))
+        throw new HandoffBusyError(sessionId, current, 'open-turn', retryAfterMs)
+      }
+      logger('handoff taking over an abandoned turn', { sessionId, idleMs: idle })
+      const generation = await rebuild(sessionId, 'open-turn-abandoned')
+      return { action: 'rebuilt', check: current, generation }
+    }
+
+    if (current.state === 'stale') {
+      const generation = await rebuild(sessionId, 'preflight-stale')
+      return { action: 'rebuilt', check: current, generation }
+    }
+    return { action: 'run', check: current }
+  }
+
+  /**
+   * Recover after a persistence conflict. The controller only rebuilds; the
+   * caller decides whether the failed turn may be retried.
+   */
+  async function recover(sessionId, reason = 'conflict') {
+    try {
+      const generation = await rebuild(sessionId, reason, false)
+      return { action: 'rebuilt', check: await check(sessionId), generation }
+    } catch (error) {
+      // The losing generation is disposed, but the winner may still be running.
+      // Resume will reject its open turn. Wait for a later request to cold-load
+      // the completed history instead of repairing or replaying it.
+      if (error?.name !== 'HandoffBusyError' && error?.code !== 'session/agent-busy'
+        && error?.name !== 'SessionPersistenceConflictError'
+        && error?.code !== 'session/handoff-busy') throw error
+      return { action: 'blocked', check: error.check ?? await persistence.handoffCheck(sessionId, 0) }
+    }
+  }
+
+  return { preflight, recover, rebuild, check }
+}
+
+/**
+ * Wire the controller to the persistence conflict event. The integration still
+ * owns the host; this only routes `session-persistence/conflict` to recover().
+ *
+ * @returns the Cordis listener disposer.
+ */
+export function attachConflictRecovery(ctx, controller, { logger = () => {} } = {}) {
+  if (!ctx || typeof ctx.on !== 'function') throw new TypeError('ctx.on is required')
+  return ctx.on(SESSION_PERSISTENCE_CONFLICT, (session, error) => {
+    const sessionId = session?.id
+    if (!sessionId) return undefined
+    return controller.recover(sessionId, 'conflict').catch(failure => {
+      logger('handoff conflict recovery failed', { sessionId, error: String(failure) })
+      throw failure
+    })
+  })
+}
