# The Brain process must be able to reach this MySQL 8 database.
MYSQL_HOST=mysql.example.com
MYSQL_PORT=3306
MYSQL_USER=dsh_brain
MYSQL_PASSWORD=replace-me
MYSQL_DATABASE=dsh-cookbook

BRAIN_PORT=8080

# Brain obtains short-lived Hands Deployment tokens through the AGS Cloud API.
AGS_REGION=ap-shanghai
AGS_API_ENDPOINT=ags.tencentcloudapi.com
AGS_DATA_PLANE_DOMAIN=tencentags.com
HANDS_OS_DEPLOYMENTS=ubuntu=dpl-replace-ubuntu,alpine=dpl-replace-alpine
TENCENTCLOUD_SECRET_ID=replace-me
TENCENTCLOUD_SECRET_KEY=replace-me
# TENCENTCLOUD_TOKEN=replace-me

# OpenAI-compatible DeepSeek route supplied by Tencent Cloud TokenHub.
TOKENHUB_API_KEY=replace-me
TOKENHUB_BASE_URL=https://tokenhub.tencentmaas.com/v1
TOKENHUB_MODEL=deepseek-v4-flash
TOKENHUB_MAX_TOKENS=16384
