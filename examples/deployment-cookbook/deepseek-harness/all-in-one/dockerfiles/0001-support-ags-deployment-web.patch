+/**
+ * Parse the one wildcard shape accepted for deployment-generated hostnames.
+ * `*.example.com` matches exactly one left-most DNS label and any port. It is
+ * deliberately not a general glob: no wildcard may appear in the suffix and
+ * nested labels such as `a.b.example.com` do not match.
+ */
+function wildcardSuffix(entry: string): string | undefined {
+  if (!entry.startsWith('*.')) return undefined
+  const suffix = entry.slice(2)
+  if (suffix === '' || suffix.includes('*') || suffix.includes(':')) return undefined
+  const suffixUrl = parseAuthority(suffix)
+  if (suffixUrl === undefined || suffixUrl.port !== '') return undefined
+  if (canonicalAuthority(suffix, suffixUrl) !== suffix.toLowerCase()) return undefined
+  return suffixUrl.hostname
+}
