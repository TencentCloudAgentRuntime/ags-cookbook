# Copy this file to .env and fill in real values. The scripts read .env directly.

# Tencent Cloud API credentials (https://console.cloud.tencent.com/cam/capi),
# used to create the VolumeTemplate and the SandboxTool.
TENCENTCLOUD_SECRET_ID=your_secret_id
TENCENTCLOUD_SECRET_KEY=your_secret_key
TENCENTCLOUD_REGION=ap-guangzhou

# AGS API Key used by the E2B SDK (not the SecretId/SecretKey above).
E2B_API_KEY=your_ags_api_key

# CAM role that AGS assumes to pull the sandbox image.
ROLE_ARN=qcs::cam::uin/<your-uin>:roleName/<your-role-name>

# Optional settings
# E2B_DOMAIN=ap-guangzhou.tencentags.com    # defaults to <TENCENTCLOUD_REGION>.tencentags.com
# SESSION_ID=session-s001                   # reuse key; the same key mounts the same Volume
# VOLUME_CAPACITY=10Gi                      # e.g. 30Gi; only applies when the template is created (see README)
# SANDBOX_IMAGE_REF=ccr.ccs.tencentyun.com/ags-image/sandbox-code:latest
# SANDBOX_IMAGE_REGISTRY_TYPE=personal      # personal (CCR) or enterprise (TCR)
