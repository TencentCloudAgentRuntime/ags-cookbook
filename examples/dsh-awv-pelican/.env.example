# Use literal values; shell substitutions are not evaluated.
KUBECONFIG=/absolute/path/to/kubeconfig
NAMESPACE=dsh-awv
REGISTRY=registry.example.com/your-namespace
IMAGE_TAG=0.2.2
STORAGE_CLASS=awv-btrfs
MODEL_SECRET=dsh-model
# Read OPENAI_API_KEY from your process environment, not this file.
OPENAI_BASE_URL=https://tokenhub.tencentmaas.com/v1
OPENAI_API_TYPE=openai-completions
DSH_MODEL=deepseek/deepseek-flash
DSH_CODE_MODEL=
DSH_REVIEW_MODEL=deepseek/deepseek-flash
# Leave empty for public images. For private images, supply a portable Docker auth JSON.
IMAGE_PULL_SECRET=
DOCKER_CONFIG_FILE=
# Optional cross-node checks: use three different Ready amd64 nodes.
CODE_NODE=
REVIEW_NODE=
SITE_NODE=
CONTROLLER_NODE=
# Optional absolute artifact directory; defaults to this example's ignored .local/.
OUTPUT_DIR=
