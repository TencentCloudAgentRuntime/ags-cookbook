# AGS (Agent Sandbox) Configuration
E2B_API_KEY=your_api_key_here
E2B_DOMAIN=ap-guangzhou.tencentags.com
AGS_TEMPLATE=your_waa_tool_id
AGS_TIMEOUT=36000

# WAA local proxy ports (override only if these local ports are occupied).
# These intentionally match native WAA inside the Windows sandbox.
WAA_SERVER_PORT=5000
WAA_CDP_PORT=9222
WAA_NOVNC_PORT=8006
WAA_VLC_PORT=8080

# OpenAI API Configuration used by WAA Navi agent
OPENAI_CLIENT_NAME=litellm
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=1.0
OPENAI_MAX_TOKENS=1500
