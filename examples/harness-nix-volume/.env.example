# Tencent Cloud / AGS control plane.
# TENCENTCLOUD_SECRET_ID=<your_tencentcloud_secret_id>
# TENCENTCLOUD_SECRET_KEY=<your_tencentcloud_secret_key>
TENCENTCLOUD_REGION="${TENCENTCLOUD_REGION:-ap-guangzhou}"
# ROLE_ARN=qcs::cam::uin/<your-uin>:roleName/ags-image-volume-role

# Destination refs for the images built and pushed by later steps. Defining
# them here does not require the images to exist yet. Use immutable tags in
# real projects.
# MAIN_IMAGE_REF=ccr.ccs.tencentyun.com/your-namespace/claude-code-nix-main:v1
MAIN_IMAGE_REGISTRY_TYPE="${MAIN_IMAGE_REGISTRY_TYPE:-personal}"
# CLAUDE_CODE_VOLUME_IMAGE_REF=ccr.ccs.tencentyun.com/your-namespace/claude-code-nix-volume:v1
CLAUDE_CODE_VOLUME_IMAGE_REGISTRY_TYPE="${CLAUDE_CODE_VOLUME_IMAGE_REGISTRY_TYPE:-personal}"

# Local image build knobs.
IMAGE_PLATFORM="${IMAGE_PLATFORM:-linux/amd64}"
NIX_BUILDER_IMAGE="${NIX_BUILDER_IMAGE:-nixos/nix:2.26.3}"

# Claude Code model configuration. The local .env file is excluded from Git and
# Docker build contexts. Set the key here or export it in the current shell.
ANTHROPIC_BASE_URL="${ANTHROPIC_BASE_URL:-https://api.deepseek.com/anthropic}"
ANTHROPIC_MODEL="${ANTHROPIC_MODEL:-deepseek-v4-flash}"
# ANTHROPIC_API_KEY=<your_api_key>

# AGS sandbox knobs. PUBLIC exposes the result page without exposing envd.
# Leave TOOL_ID empty on the first run so the helper creates a Tool from the
# configured images. Set an existing Tool ID on later runs to reuse it.
TOOL_ID="${TOOL_ID:-}"
TOOL_NAME="${TOOL_NAME:-claude-code-agent-volume}"
# A Tool created by the helper uses a one-hour time-limited sandbox.
INSTANCE_TIMEOUT="${INSTANCE_TIMEOUT:-1h}"
ENVD_PORT="${ENVD_PORT:-49983}"
ENVD_VERSION="${ENVD_VERSION:-0.5.14}"
DEMO_HTTP_PORT="${DEMO_HTTP_PORT:-8080}"
RUNTIME_CPU="${RUNTIME_CPU:-2}"
RUNTIME_MEMORY="${RUNTIME_MEMORY:-4Gi}"
CLAUDE_MAX_TURNS="${CLAUDE_MAX_TURNS:-8}"
CLAUDE_RUN_TIMEOUT_SECONDS="${CLAUDE_RUN_TIMEOUT_SECONDS:-600}"
# TASK_TOPIC="最近 24 小时最重要的 AI 行业新闻"
# AGENT_TASK="Research and write a concise Chinese news briefing with sources."

# Optional gateway override for sandbox exposed port requests.
# AGS_GATEWAY_DOMAIN=ap-guangzhou.tencentags.com
AGS_SANDBOX_PORT_SCHEME="${AGS_SANDBOX_PORT_SCHEME:-https}"

# Keep existing tool by default during cleanup.
DELETE_TOOL="${DELETE_TOOL:-0}"
