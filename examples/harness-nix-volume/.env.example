# Tencent Cloud / AGS control plane.
# TENCENTCLOUD_SECRET_ID=<your_tencentcloud_secret_id>
# TENCENTCLOUD_SECRET_KEY=<your_tencentcloud_secret_key>
TENCENTCLOUD_REGION="${TENCENTCLOUD_REGION:-ap-guangzhou}"
# ROLE_ARN=qcs::cam::uin/<your-uin>:roleName/ags-image-volume-role

# Container registry image refs. Use immutable tags in real projects.
# MAIN_IMAGE_REF=ccr.ccs.tencentyun.com/your-namespace/harness-nix-main:20260630
MAIN_IMAGE_REGISTRY_TYPE="${MAIN_IMAGE_REGISTRY_TYPE:-personal}"
# HARNESS_VOLUME_IMAGE_REF=ccr.ccs.tencentyun.com/your-namespace/harness-nix-volume:20260630
HARNESS_VOLUME_IMAGE_REGISTRY_TYPE="${HARNESS_VOLUME_IMAGE_REGISTRY_TYPE:-personal}"

# Local image build knobs.
CONTAINER_ENGINE="${CONTAINER_ENGINE:-podman}"
IMAGE_PLATFORM="${IMAGE_PLATFORM:-linux/amd64}"
NIX_BUILDER_IMAGE="${NIX_BUILDER_IMAGE:-nixos/nix:2.26.3}"
# Running Nix inside a container may require relaxing build-time seccomp,
# especially with podman machine on macOS. Set empty to disable the flag.
CONTAINER_BUILD_SECURITY_OPT="${CONTAINER_BUILD_SECURITY_OPT:-seccomp=unconfined}"

# AGS sandbox knobs.
TOOL_NAME="${TOOL_NAME:-harness-nix-volume-demo}"
NETWORK_MODE="${NETWORK_MODE:-SANDBOX}"
INSTANCE_TIMEOUT="${INSTANCE_TIMEOUT:-30m}"
HARNESS_PORT="${HARNESS_PORT:-18080}"
RUNTIME_CPU="${RUNTIME_CPU:-2}"
RUNTIME_MEMORY="${RUNTIME_MEMORY:-4Gi}"

# Optional gateway override for sandbox exposed port requests.
# AGS_GATEWAY_DOMAIN=ap-guangzhou.tencentags.com
AGS_SANDBOX_PORT_SCHEME="${AGS_SANDBOX_PORT_SCHEME:-https}"

# Keep existing tool by default during cleanup.
DELETE_TOOL="${DELETE_TOOL:-0}"
