# Tencent Cloud / AGS control plane.
# TENCENTCLOUD_SECRET_ID=<your_tencentcloud_secret_id>
# TENCENTCLOUD_SECRET_KEY=<your_tencentcloud_secret_key>
# TENCENTCLOUD_REGION=ap-guangzhou
# ROLE_ARN=qcs::cam::uin/1000000000:roleName/ags-image-volume-role

# Image volume artifacts. Use immutable tags instead of latest.
# MAIN_IMAGE_REF=ccr.ccs.tencentyun.com/your-namespace/local-service-tunnel-main:20260626
MAIN_IMAGE_REGISTRY_TYPE="${MAIN_IMAGE_REGISTRY_TYPE:-personal}"
# TUNNEL_IMAGE_REF=ccr.ccs.tencentyun.com/your-namespace/ags-tunnel-bin:20260626
TUNNEL_IMAGE_REGISTRY_TYPE="${TUNNEL_IMAGE_REGISTRY_TYPE:-personal}"
# WORKLOAD_IMAGE_REF=ccr.ccs.tencentyun.com/your-namespace/demo-workload-claude-code:20260626
WORKLOAD_IMAGE_REGISTRY_TYPE="${WORKLOAD_IMAGE_REGISTRY_TYPE:-personal}"
WORKLOAD_IMAGE_SUBPATH="${WORKLOAD_IMAGE_SUBPATH:-/workload}"

# envd is mounted by default so the example can use E2B commands.run() for
# verification and debugging.
ENVD_IMAGE_REF="${ENVD_IMAGE_REF:-ccr.ccs.tencentyun.com/ags-image/envd:v0.5.14}"
ENVD_IMAGE_REGISTRY_TYPE="${ENVD_IMAGE_REGISTRY_TYPE:-personal}"
ENVD_IMAGE_SUBPATH="${ENVD_IMAGE_SUBPATH:-/usr/bin/envd}"
ENVD_PORT="${ENVD_PORT:-49983}"

# Required only when building the Claude Code demo workload image from a local
# portable tree. Generate it with ./scripts/build-claude-code-dir.sh.
CLAUDE_CODE_DIR="${CLAUDE_CODE_DIR:-dist/claude-code-linux-amd64/claude-code}"

# Local client configuration. The allowlist is YAML-only.
AGS_TUNNEL_POLICY_FILE="${AGS_TUNNEL_POLICY_FILE:-config/tunnel-policy.yaml}"
# Optional. Use this when one local client should connect to multiple existing
# sandbox instances. The default demo does not need it.
# AGS_TUNNEL_SESSION_FILE=config/tunnel-sessions.yaml
# DEEPSEEK_API_KEY=<your_upstream_api_key>

# Optional sandbox knobs.
NETWORK_MODE="${NETWORK_MODE:-SANDBOX}"
INSTANCE_TIMEOUT="${INSTANCE_TIMEOUT:-30m}"
LOCAL_TUNNEL_PORT="${LOCAL_TUNNEL_PORT:-18081}"
REMOTE_TUNNEL_PORT="${REMOTE_TUNNEL_PORT:-18081}"
WORKLOAD_TUNNEL_PORT="${WORKLOAD_TUNNEL_PORT:-18080}"
RUNTIME_CPU="${RUNTIME_CPU:-2}"
RUNTIME_MEMORY="${RUNTIME_MEMORY:-4Gi}"
IMAGE_PLATFORM="${IMAGE_PLATFORM:-linux/amd64}"

# The AGS custom tool starts envd and the tunnel server with this one command.
# Override only if your mount paths or ports differ.
TOOL_START_COMMAND="${TOOL_START_COMMAND:-/envd -port 49983 >/tmp/envd.log 2>&1 & exec /mnt/tunnel/bin/ags-tunnel-server}"

# Optional Claude Code demo controls. Claude Code is only a demo workload.
RUN_DEMO="${RUN_DEMO:-1}"
# CLAUDE_PERMISSION_MODE=bypassPermissions
# CLAUDE_ALLOWED_TOOLS=WebSearch
# CLAUDE_DANGEROUSLY_SKIP_PERMISSIONS=true
# SANDBOX_ANTHROPIC_MODEL=deepseek-v4-pro[1m]

# Optional in-sandbox allowlist verification. Requires E2B_API_KEY because it
# uses commands.run() through envd to execute curl inside the sandbox.
RUN_ALLOWLIST_TEST="${RUN_ALLOWLIST_TEST:-0}"
RUN_MULTI_TURN_TEST="${RUN_MULTI_TURN_TEST:-0}"
# E2B_API_KEY=<your_e2b_api_key>
# E2B_DOMAIN=ap-guangzhou.tencentags.com
ALLOWLIST_UPSTREAM_PORT="${ALLOWLIST_UPSTREAM_PORT:-18090}"
ALLOWLIST_TEST_ALLOWED_PATH="${ALLOWLIST_TEST_ALLOWED_PATH:-/allowlist-ok}"
ALLOWLIST_TEST_DENIED_PATH="${ALLOWLIST_TEST_DENIED_PATH:-/blocked}"
ALLOWLIST_ALLOWED_IP_CIDRS="${ALLOWLIST_ALLOWED_IP_CIDRS:-127.0.0.1/32}"
MULTI_TURN_UPSTREAM_PORT="${MULTI_TURN_UPSTREAM_PORT:-18091}"
