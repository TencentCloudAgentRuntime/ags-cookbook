# Shared by all five scenarios. Use your existing agr credential configuration.
AGR_REGION=ap-chongqing
AGR_ROLE_ARN='qcs::cam::uin/100000000001:roleName/replace-me'
HARNESS_SUBNET_ID=subnet-replace-me
HARNESS_SECURITY_GROUP_ID=sg-replace-me
TOKENHUB_API_KEY_ID=ak-replace-me

# Start with a lowercase letter or digit; use only lowercase letters, digits,
# hyphens and dots. Choose a suffix unique to you.
HARNESS_NAME_SUFFIX=your-name
