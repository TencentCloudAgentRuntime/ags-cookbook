# Tencent Cloud credentials. Prefer a dedicated sub-account or temporary credentials.
TENCENTCLOUD_SECRET_ID=replace-with-secret-id
TENCENTCLOUD_SECRET_KEY=replace-with-secret-key
TENCENTCLOUD_TOKEN=
TENCENTCLOUD_REGION=ap-chongqing

# Existing ACTIVE Registry with AUTO approval mode.
AGENT_REGISTRY_ID=reg-replace-me
AGENT_REGISTRY_ENDPOINT=https://registry.tencentcloudapi.com/

# Any OpenAI-compatible chat-completions endpoint used by the five demo agents.
OPENAI_API_KEY=replace-with-model-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=replace-with-model-name
OPENAI_MAX_TOKENS=16384

# The A2A endpoints written into Registry descriptors. The DSH process that invokes
# them must be able to reach this address. The localhost default is suitable when
# the demo services and DSH run on the same host.
DEMO_HOST=127.0.0.1
DEMO_PORT=18080
DEMO_PUBLIC_BASE_URL=http://127.0.0.1:18080
DEMO_MCP_HOST=127.0.0.1
DEMO_MCP_PORT=18081
DEMO_RECORD_PREFIX=demo-rd
