# Tencent Cloud credentials. Never commit real values.
TENCENTCLOUD_SECRET_ID=your-secret-id
TENCENTCLOUD_SECRET_KEY=your-secret-key
TENCENTCLOUD_REGION=ap-guangzhou

# Image produced by this example.
ENVD_DEMO_IMAGE=ccr.ccs.tencentyun.com/your-namespace/your-repository:envd-oci-env

# personal or enterprise
ENVD_IMAGE_REGISTRY_TYPE=personal

# CAM role that lets AGS read the image registry.
AGS_ROLE_ARN=qcs::cam::uin/your-account-id:roleName/your-role-name

# User present in the base image. The supplied demo image uses root.
AGS_EXEC_USER=root

# Replace this when adapting the Dockerfile to an existing application image.
BASE_IMAGE=ubuntu:22.04
