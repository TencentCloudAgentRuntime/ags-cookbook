# Tencent Cloud credentials. Never commit real values.
TENCENTCLOUD_SECRET_ID=your-secret-id
TENCENTCLOUD_SECRET_KEY=your-secret-key
TENCENTCLOUD_REGION=ap-guangzhou

# Image produced by this example.
ENVD_DEMO_IMAGE=ccr.ccs.tencentyun.com/your-namespace/your-repository:envd-oci-env

# Supported values: 0.5.14, 0.5.14-modified, or 0.2.11.
ENVD_VERSION=0.5.14

# personal or enterprise
ENVD_IMAGE_REGISTRY_TYPE=personal

# CAM role that lets AGS read the image registry.
AGS_ROLE_ARN=qcs::cam::uin/your-account-id:roleName/your-role-name

# User present in the base image. The supplied demo image uses root.
AGS_EXEC_USER=root

# Replace this when adapting the Dockerfile to an existing application image.
BASE_IMAGE=ubuntu:22.04

# --- OCI User/Workdir defaults (ENVD_VERSION=0.5.14-modified only) ------------
# These are used by the envd-volume / fixtures / run-user-workdir targets.
# Placeholders only: never commit real values.

# envd Image Volume artifact: one file, /usr/bin/envd, owned 0:0 with mode 4755.
# Use a unique, immutable tag. Do not use `latest`: the delivery is identified by
# the manifest digest, and a mutable tag makes that impossible to pin.
ENVD_VOLUME_IMAGE=ccr.ccs.tencentyun.com/your-namespace/envd-oci-user-workdir:envd-volume-0.5.14-modified-YYYYMMDDHHMMSS
# Record the sha256:... returned by docker push / AGS pre-cache. The E2E script
# fails if this tag resolves to any other digest.
ENVD_VOLUME_IMAGE_DIGEST=sha256:replace-with-the-recorded-manifest-digest

# Business fixtures standing in for a customer image.
# A: named OCI user with supplementary groups. B: bare numeric OCI UID with no
# passwd entry.
FIXTURE_A_IMAGE=ccr.ccs.tencentyun.com/your-namespace/envd-oci-fixture-a:vYYYYMMDDHHMMSS
FIXTURE_B_IMAGE=ccr.ccs.tencentyun.com/your-namespace/envd-oci-fixture-b:vYYYYMMDDHHMMSS

# Where the Image Volume is mounted inside the business rootfs. The Tool's
# Command points at <ENVD_VOLUME_MOUNT_PATH>/usr/bin/envd.
ENVD_VOLUME_MOUNT_PATH=/opt/envd

# AGS instance timeout for the temporary test sandboxes. Keep it short; the spec
# caps it at 30m.
AGS_INSTANCE_TIMEOUT=20m

# E2B-compatible data plane, used by validate_user_workdir.py.
# Keep the AGS-issued ark_ key here. The validation script replaces only the
# prefix with e2b_ before invoking the SDK; AGS accepts the normalized form.
AGS_API_KEY=ark_replace-with-your-ags-api-key
E2B_DOMAIN=ap-guangzhou.tencentags.com

# This metadata value prevents the SDK from injecting its legacy default user.
# The script passes it as instance Metadata Key x-envd-version.
AGS_ENVD_VERSION_METADATA=0.4.0
